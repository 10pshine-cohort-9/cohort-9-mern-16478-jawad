NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/app_notes_db?schema=public

JWT_SECRET=replace_this_with_a_minimum_32_character_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=notes_access_token

LOG_LEVEL=info
PROFILE_UPLOAD_DIR=uploads/profiles
MAX_PROFILE_IMAGE_SIZE_MB=5