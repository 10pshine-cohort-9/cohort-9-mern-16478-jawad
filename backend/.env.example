NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DATABASE_URL="postgresql://app_notes_user:YOUR_PASSWORD@localhost:5432/app_notes_db?schema=public"

SHADOW_DATABASE_URL="postgresql://app_notes_user:YOUR_PASSWORD@localhost:5432/app_notes_shadow_db?schema=public"

SHADOW_DATABASE_URL="postgresql://app_notes_user:YOUR_PASSWORD@localhost:5432/app_notes_shadow_db?schema=public"

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=notes-app-api
JWT_AUDIENCE=notes-app-client

COOKIE_NAME=notes_access_token
AUTH_COOKIE_MAX_AGE_MS=604800000

LOG_LEVEL=info
PROFILE_UPLOAD_DIR=uploads/profiles
MAX_PROFILE_IMAGE_SIZE_MB=5

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM_NAME=Notes App
MAIL_FROM_EMAIL=your_email@gmail.com


PASSWORD_RESET_SECRET=replace_with_a_secure_random_secret
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_COOKIE_NAME=notes_password_reset_token