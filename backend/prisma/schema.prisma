generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum NoteActivityType {
  CREATED
  UPDATED
  PINNED
  UNPINNED
  FAVORITED
  UNFAVORITED
  TRASHED
  RESTORED
  PERMANENTLY_DELETED
}

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  fullName             String   @map("full_name") @db.VarChar(120)
  username             String   @unique @db.VarChar(30)
  email                String   @unique @db.VarChar(255)
  phoneNumber          String   @unique @map("phone_number") @db.VarChar(20)
  city                 String   @db.VarChar(100)
  gender               Gender
  profileImageUrl      String   @map("profile_image_url") @db.VarChar(500)
  profileImagePublicId String   @map("profile_image_public_id") @db.VarChar(255)
  passwordHash         String   @map("password_hash") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  notes          Note[]
  passwordReset  PasswordReset?
  noteActivities NoteActivity[]

  @@index([createdAt])
  @@map("users")
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  title      String    @db.VarChar(200)
  content    String    @db.Text
  isPinned   Boolean   @default(false) @map("is_pinned")
  isFavorite Boolean   @default(false) @map("is_favorite")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities NoteActivity[]

  @@index([userId, updatedAt])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, isPinned, deletedAt])
  @@index([userId, isFavorite, deletedAt])
  @@map("notes")
}

model NoteActivity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  noteId    String?          @map("note_id") @db.Uuid
  type      NoteActivityType
  noteTitle String           @map("note_title") @db.VarChar(200)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([noteId])
  @@map("note_activities")
}

model PasswordReset {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  otpHash             String    @map("otp_hash") @db.VarChar(64)
  attempts            Int       @default(0)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(3)
  resetTokenHash      String?   @unique @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_resets")
}
